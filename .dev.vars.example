# Copy to .dev.vars for local Cloudflare Worker development.
# Never commit real values. Production secrets use `wrangler secret put`.
TELEGRAM_BOT_TOKEN=replace_with_your_development_bot_token
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_development_secret

# Your numeric Telegram user ID; blank disables the admin panel.
SUPER_ADMIN_ID=
