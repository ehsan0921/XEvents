TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
BOT_USERNAME=XEvents_bot
DATA_DIR=./data

# Cloudflare Mini App admin setting (not used by the standalone polling bot).
# Enter your own numeric Telegram user ID. Blank disables super admin access.
# In production, set it with: npx wrangler secret put SUPER_ADMIN_ID
SUPER_ADMIN_ID=
